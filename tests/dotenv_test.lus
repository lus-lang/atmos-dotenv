local ROOT = string.match(TEST_DIR, "^(.*)[/\\][^/\\]*$")
pledge("load", "fs")
package.path = ROOT .. "/?.lus;" .. package.path

local dotenv = require("dotenv")

local function basic_test()
    local env = dotenv.parse([[
# comment
PORT=8080
export HOST = localhost
EMPTY=
SPACED =  a value with spaces   # trailing comment
HASH=a#b
]])
    assert(env.PORT == "8080")
    assert(env.HOST == "localhost")
    assert(env.EMPTY == "")
    assert(env.SPACED == "a value with spaces")
    assert(env.HASH == "a#b")
end

local function quotes_test()
    local env = dotenv.parse("SINGLE='literal $HOME \\n'\nDOUBLE=\"tab\\there \\\"q\\\"\"\nMULTI=\"line one\nline two\"\nAFTER=1\n")
    assert(env.SINGLE == "literal $HOME \\n")
    assert(env.DOUBLE == 'tab\there "q"')
    assert(env.MULTI == "line one\nline two")
    assert(env.AFTER == "1")
end

local function expansion_test()
    local env = dotenv.parse([[
USER=ada
HOME=/home/${USER}
BIN=$HOME/bin
MISSING=${NOPE:-fallback}
SET=${USER:-other}
ESCAPED="cost \$5"
]])
    assert(env.HOME == "/home/ada")
    assert(env.BIN == "/home/ada/bin")
    assert(env.MISSING == "fallback")
    assert(env.SET == "ada")
    assert(env.ESCAPED == "cost $5")
    assert(dotenv.parse("A=$B", { expand = false }).A == "$B")
end

local function errors_test()
    local ok, err = catch dotenv.parse("GOOD=1\nnot a definition\n")
    assert(not ok and err:find(".env line 2", 1, true))
    assert(not catch dotenv.parse("A='open"))
    assert(not catch dotenv.parse('A="open'))
end

local function crlf_test()
    local env = dotenv.parse("A=1\r\nB=2\r\n")
    assert(env.A == "1" and env.B == "2")
end

local function load_and_get_test()
    local path = os.tmpname()
    local f <close> = io.open(path, "w")
    f:write("TOKEN=abc\n")
    f:close()
    dotenv.reset()
    assert(dotenv.load(path).TOKEN == "abc")
    assert(dotenv.get("TOKEN") == "abc")
    assert(dotenv.get("SURELY_UNSET_NAME", "d") == "d")
    assert(next(dotenv.load(path .. ".missing")) == nil)
    assert(not catch dotenv.load(path .. ".missing", { required = true }))
    fs.remove(path)
end
